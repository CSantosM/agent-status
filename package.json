{
  "name": "agent-status",
  "displayName": "Agent Status",
  "description": "A status bar chip with one dot per running coding agent session (Claude Code for now): working, waiting or idle.",
  "icon": "media/icon.png",
  "version": "0.9.2",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "author": "Carlos Santos",
  "repository": {
    "type": "git",
    "url": "https://github.com/CSantosM/agent-status.git"
  },
  "homepage": "https://github.com/CSantosM/agent-status#readme",
  "bugs": {
    "url": "https://github.com/CSantosM/agent-status/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "./package.sh",
    "install-extension": "./package.sh --install"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentStatus.showSessions",
        "title": "Show Sessions",
        "category": "Agent Status"
      },
      {
        "command": "agentStatus.filterByStatus",
        "title": "Filter by Status",
        "category": "Agent Status",
        "icon": "$(filter)"
      },
      {
        "command": "agentStatus.refresh",
        "title": "Refresh",
        "category": "Agent Status",
        "icon": "$(refresh)"
      },
      {
        "command": "agentStatus.groupByBranch",
        "title": "Group by Branch",
        "category": "Agent Status",
        "icon": "$(git-branch)"
      },
      {
        "command": "agentStatus.ungroup",
        "title": "Show as List",
        "category": "Agent Status",
        "icon": "$(list-flat)"
      },
      {
        "command": "agentStatus.playFinishSound",
        "title": "Play Finish Sound",
        "category": "Agent Status"
      },
      {
        "command": "agentStatus.playWaitingSound",
        "title": "Play Waiting Sound",
        "category": "Agent Status"
      },
      {
        "command": "agentStatus.showLog",
        "title": "Show Log",
        "category": "Agent Status"
      },
      {
        "command": "agentStatus.open",
        "title": "Open Session",
        "category": "Agent Status",
        "icon": "$(link-external)"
      },
      {
        "command": "agentStatus.openFileDiff",
        "title": "Open Changes",
        "category": "Agent Status",
        "icon": "$(diff)"
      },
      {
        "command": "agentStatus.openFile",
        "title": "Open File",
        "category": "Agent Status",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentStatus.setFilter",
        "title": "Set Filter",
        "category": "Agent Status"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentStatus.open",
          "when": "false"
        },
        {
          "command": "agentStatus.setFilter",
          "when": "false"
        },
        {
          "command": "agentStatus.openFileDiff",
          "when": "false"
        },
        {
          "command": "agentStatus.openFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentStatus.groupByBranch",
          "when": "view == agentStatus.sessions && config.agentStatus.groupBy != branch",
          "group": "navigation@1"
        },
        {
          "command": "agentStatus.ungroup",
          "when": "view == agentStatus.sessions && config.agentStatus.groupBy == branch",
          "group": "navigation@1"
        },
        {
          "command": "agentStatus.filterByStatus",
          "when": "view == agentStatus.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentStatus.refresh",
          "when": "view == agentStatus.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentStatus.open",
          "when": "view == agentStatus.sessions && viewItem == session.openable",
          "group": "inline"
        },
        {
          "command": "agentStatus.openFileDiff",
          "when": "view == agentStatus.sessions && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "agentStatus.openFile",
          "when": "view == agentStatus.sessions && viewItem == file",
          "group": "inline@2"
        },
        {
          "command": "agentStatus.open",
          "when": "view == agentStatus.sessions && viewItem == session.openable",
          "group": "1_open"
        },
        {
          "command": "agentStatus.openFileDiff",
          "when": "view == agentStatus.sessions && viewItem == file",
          "group": "1_open@1"
        },
        {
          "command": "agentStatus.openFile",
          "when": "view == agentStatus.sessions && viewItem == file",
          "group": "1_open@2"
        }
      ]
    },
    "configuration": {
      "title": "Agent Status",
      "properties": {
        "agentStatus.scope": {
          "type": "string",
          "enum": [
            "window",
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "Only sessions started from this window: its Claude Code chats and its integrated terminals.",
            "Sessions from this window plus any other session whose folder is inside this workspace.",
            "Every Claude Code session running on this machine."
          ],
          "default": "window",
          "description": "Which sessions the chip shows. Sessions that belong elsewhere are listed but cannot be opened from this window."
        },
        "agentStatus.showEmptySessions": {
          "type": "boolean",
          "default": false,
          "description": "Also show chats that have no messages yet. They are never opened from here: Claude Code cannot restore an empty chat and would start a new one instead."
        },
        "agentStatus.soundOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "Play a short blip when a session in this window finishes its turn (goes from working to idle)."
        },
        "agentStatus.soundOnWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Play a short alert when a session in this window stops to wait for your decision, such as a permission request (goes from working to waiting)."
        },
        "agentStatus.finishSoundFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path of a `.wav` file to play instead of the built-in finish blip. Try it with **Agent Status: Play Finish Sound**."
        },
        "agentStatus.waitingSoundFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path of a `.wav` file to play instead of the built-in waiting sound. Try it with **Agent Status: Play Waiting Sound**."
        },
        "agentStatus.notifyOnWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification with an Open button when a session in this window stops to wait for your decision."
        },
        "agentStatus.order": {
          "type": "string",
          "enum": [
            "stable",
            "status"
          ],
          "enumDescriptions": [
            "Start order: every dot keeps its position when its status changes.",
            "Waiting first, then working, then idle."
          ],
          "default": "stable",
          "description": "Order of the dots, the hover list and the session picker."
        },
        "agentStatus.groupBy": {
          "type": "string",
          "enum": [
            "none",
            "branch"
          ],
          "default": "none",
          "enumDescriptions": [
            "One list of sessions.",
            "Keep sessions in the same branch or worktree together, in the chip, hover, picker and panel."
          ],
          "description": "How sessions are grouped. Sessions sharing a working tree end up together, which shows agents that may step on each other."
        },
        "agentStatus.icon": {
          "type": "string",
          "default": "agent-status-robot",
          "markdownDescription": "Icon at the start of the chip: `agent-status-robot` (the extension's robot, as in the activity bar) or any codicon, such as `robot` or `sparkle`."
        },
        "agentStatus.iconReflectsStatus": {
          "type": "boolean",
          "default": true,
          "description": "Color the icon with the most urgent status: red if any session is waiting, yellow if any is working."
        },
        "agentStatus.maxDots": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "description": "Maximum number of dots; the rest are grouped as +N."
        },
        "agentStatus.hideWhenEmpty": {
          "type": "boolean",
          "default": false,
          "description": "Hide the chip when no sessions are running."
        },
        "agentStatus.dots": {
          "type": "object",
          "default": {
            "busy": "🟡",
            "waiting": "🔴",
            "idle": "🟢"
          },
          "properties": {
            "busy": {
              "type": "string"
            },
            "waiting": {
              "type": "string"
            },
            "idle": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Character shown for each status. A status bar item has a single text color, so colored emoji are what make the dots differ."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentStatus",
          "title": "Agent Status",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentStatus": [
        {
          "id": "agentStatus.sessions",
          "name": "Sessions",
          "contextualTitle": "Agent Status"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentStatus.sessions",
        "contents": "No agent sessions are running in this window.\n\nStart one in Claude Code, or show sessions from other windows with the [Scope setting](command:workbench.action.openSettings?%5B%22agentStatus.scope%22%5D)."
      }
    ],
    "icons": {
      "agent-status-robot": {
        "description": "The Agent Status robot",
        "default": {
          "fontPath": "media/agent-status.woff",
          "fontCharacter": "\\E000"
        }
      }
    }
  },
  "keywords": [
    "agents",
    "claude code",
    "ai",
    "status bar",
    "multi-agent",
    "sessions"
  ]
}
