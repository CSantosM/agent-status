{
  "name": "agent-watch-status",
  "displayName": "Agent Watch",
  "description": "Watch your coding agents from the status bar: one dot per session (working, waiting or idle), what each is doing, the files it changed, and a sound when it needs you. Supports Claude Code.",
  "icon": "media/icon.png",
  "version": "0.1.0",
  "publisher": "csantosm",
  "preview": true,
  "license": "MIT",
  "author": "Carlos Santos",
  "repository": {
    "type": "git",
    "url": "https://github.com/CSantosM/agent-watch.git"
  },
  "homepage": "https://github.com/CSantosM/agent-watch#readme",
  "bugs": {
    "url": "https://github.com/CSantosM/agent-watch/issues"
  },
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "agents",
    "claude code",
    "claude",
    "ai agents",
    "multi-agent",
    "status bar",
    "sessions",
    "worktrees"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "scripts": {
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "node --test --test-reporter=dot test/*.test.js",
    "package": "npx --yes @vscode/vsce@4 package",
    "publish": "npx --yes @vscode/vsce@4 publish"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentWatch.showSessions",
        "title": "Show Sessions",
        "category": "Agent Watch"
      },
      {
        "command": "agentWatch.filterByStatus",
        "title": "Filter by Status",
        "category": "Agent Watch",
        "icon": "$(filter)"
      },
      {
        "command": "agentWatch.refresh",
        "title": "Refresh",
        "category": "Agent Watch",
        "icon": "$(refresh)"
      },
      {
        "command": "agentWatch.groupByBranch",
        "title": "Group by Branch",
        "category": "Agent Watch",
        "icon": "$(git-branch)"
      },
      {
        "command": "agentWatch.ungroup",
        "title": "Show as List",
        "category": "Agent Watch",
        "icon": "$(list-flat)"
      },
      {
        "command": "agentWatch.playFinishSound",
        "title": "Play Finish Sound",
        "category": "Agent Watch"
      },
      {
        "command": "agentWatch.playWaitingSound",
        "title": "Play Waiting Sound",
        "category": "Agent Watch"
      },
      {
        "command": "agentWatch.showLog",
        "title": "Show Log",
        "category": "Agent Watch"
      },
      {
        "command": "agentWatch.open",
        "title": "Open Session",
        "category": "Agent Watch",
        "icon": "$(link-external)"
      },
      {
        "command": "agentWatch.openFileDiff",
        "title": "Open Changes",
        "category": "Agent Watch",
        "icon": "$(diff)"
      },
      {
        "command": "agentWatch.openFile",
        "title": "Open File",
        "category": "Agent Watch",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentWatch.setFilter",
        "title": "Set Filter",
        "category": "Agent Watch"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentWatch.open",
          "when": "false"
        },
        {
          "command": "agentWatch.setFilter",
          "when": "false"
        },
        {
          "command": "agentWatch.openFileDiff",
          "when": "false"
        },
        {
          "command": "agentWatch.openFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentWatch.groupByBranch",
          "when": "view == agentWatch.sessions && config.agentWatch.groupBy != branch",
          "group": "navigation@1"
        },
        {
          "command": "agentWatch.ungroup",
          "when": "view == agentWatch.sessions && config.agentWatch.groupBy == branch",
          "group": "navigation@1"
        },
        {
          "command": "agentWatch.filterByStatus",
          "when": "view == agentWatch.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentWatch.refresh",
          "when": "view == agentWatch.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentWatch.open",
          "when": "view == agentWatch.sessions && viewItem == session.openable",
          "group": "inline"
        },
        {
          "command": "agentWatch.openFileDiff",
          "when": "view == agentWatch.sessions && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "agentWatch.openFile",
          "when": "view == agentWatch.sessions && viewItem == file",
          "group": "inline@2"
        },
        {
          "command": "agentWatch.open",
          "when": "view == agentWatch.sessions && viewItem == session.openable",
          "group": "1_open"
        },
        {
          "command": "agentWatch.openFileDiff",
          "when": "view == agentWatch.sessions && viewItem == file",
          "group": "1_open@1"
        },
        {
          "command": "agentWatch.openFile",
          "when": "view == agentWatch.sessions && viewItem == file",
          "group": "1_open@2"
        }
      ]
    },
    "configuration": {
      "title": "Agent Watch",
      "properties": {
        "agentWatch.scope": {
          "type": "string",
          "enum": [
            "window",
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "Only sessions started from this window: its Claude Code chats and its integrated terminals.",
            "Sessions from this window plus any other session whose folder is inside this workspace.",
            "Every Claude Code session running on this machine."
          ],
          "default": "window",
          "description": "Which sessions the chip shows. Sessions that belong elsewhere are listed but cannot be opened from this window."
        },
        "agentWatch.showEmptySessions": {
          "type": "boolean",
          "default": false,
          "description": "Also show chats that have no messages yet. They are never opened from here: Claude Code cannot restore an empty chat and would start a new one instead."
        },
        "agentWatch.soundOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "Play a short blip when a session in this window finishes its turn (goes from working to idle)."
        },
        "agentWatch.soundOnWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Play a short alert when a session in this window stops to wait for your decision, such as a permission request (goes from working to waiting)."
        },
        "agentWatch.finishSoundFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path of a `.wav` file to play instead of the built-in finish blip. Try it with **Agent Watch: Play Finish Sound**."
        },
        "agentWatch.waitingSoundFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path of a `.wav` file to play instead of the built-in waiting sound. Try it with **Agent Watch: Play Waiting Sound**."
        },
        "agentWatch.notifyOnWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification with an Open button when a session in this window stops to wait for your decision."
        },
        "agentWatch.order": {
          "type": "string",
          "enum": [
            "stable",
            "status"
          ],
          "enumDescriptions": [
            "Start order: every dot keeps its position when its status changes.",
            "Waiting first, then working, then idle."
          ],
          "default": "stable",
          "description": "Order of the dots, the hover list and the session picker."
        },
        "agentWatch.groupBy": {
          "type": "string",
          "enum": [
            "none",
            "branch"
          ],
          "default": "none",
          "enumDescriptions": [
            "One list of sessions.",
            "Keep sessions in the same branch or worktree together, in the chip, hover, picker and panel."
          ],
          "description": "How sessions are grouped. Sessions sharing a working tree end up together, which shows agents that may step on each other."
        },
        "agentWatch.icon": {
          "type": "string",
          "default": "agent-watch-robot",
          "markdownDescription": "Icon at the start of the chip: `agent-watch-robot` (the extension's robot, as in the activity bar) or any codicon, such as `robot` or `sparkle`."
        },
        "agentWatch.iconReflectsStatus": {
          "type": "boolean",
          "default": true,
          "description": "Color the icon with the most urgent status: red if any session is waiting, yellow if any is working."
        },
        "agentWatch.maxDots": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "description": "Maximum number of dots; the rest are grouped as +N."
        },
        "agentWatch.hideWhenEmpty": {
          "type": "boolean",
          "default": false,
          "description": "Hide the chip when no sessions are running."
        },
        "agentWatch.dots": {
          "type": "object",
          "default": {
            "busy": "🟡",
            "waiting": "🔴",
            "idle": "🟢"
          },
          "properties": {
            "busy": {
              "type": "string"
            },
            "waiting": {
              "type": "string"
            },
            "idle": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Character shown for each status. A status bar item has a single text color, so colored emoji are what make the dots differ."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentWatch",
          "title": "Agent Watch",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentWatch": [
        {
          "id": "agentWatch.sessions",
          "name": "Sessions",
          "contextualTitle": "Agent Watch"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentWatch.sessions",
        "contents": "No agent sessions are running in this window.\n\nStart one in Claude Code, or show sessions from other windows with the [Scope setting](command:workbench.action.openSettings?%5B%22agentWatch.scope%22%5D)."
      }
    ],
    "icons": {
      "agent-watch-robot": {
        "description": "The Agent Watch robot",
        "default": {
          "fontPath": "media/agent-watch.woff",
          "fontCharacter": "\\E000"
        }
      }
    }
  }
}
